# see https://github.com/qdm12/gluetun-wiki for the full option list and VPN provider setup
VPN_SERVICE_PROVIDER=mullvad
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=your_wireguard_private_key
WIREGUARD_ADDRESSES=10.x.x.x/32
# Spizoo-network sites serve an SFW page to most hosting ASNs; Mullvad's xtom-hosted
# New York relays are the only tested exits that pass (2026-11-09)
SERVER_HOSTNAMES=us-nyc-wg-001,us-nyc-wg-002,us-nyc-wg-003

# required: gluetun's firewall only opens ports it declares itself (DNS, its own HTTP
# proxy, control server) - not ports belonging to whatever else shares its network
# namespace via network_mode: "service:gluetun" (e.g. cdp's DevTools port)
FIREWALL_INPUT_PORTS=9222
