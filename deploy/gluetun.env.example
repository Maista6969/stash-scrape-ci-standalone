# see https://github.com/qdm12/gluetun-wiki for the full option list and VPN provider setup
VPN_SERVICE_PROVIDER=mullvad
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=your_wireguard_private_key
WIREGUARD_ADDRESSES=10.x.x.x/32
# xtom New York: Spizoo only accepts xtom-hosted exits, and New York has no adult-site age-verification
# law, unlike the EU exits that got language/age redirects; the other xtom cities are blocked by Spizoo
# (HK, Osaka, LAX) or under age-assurance rules (Sydney, London). See HANDOFF.md
SERVER_HOSTNAMES=us-nyc-wg-001,us-nyc-wg-002,us-nyc-wg-003

# required: gluetun's firewall only opens ports it declares itself (DNS, its own HTTP
# proxy, control server) - not ports belonging to whatever else shares its network
# namespace via network_mode: "service:gluetun" (cdp's DevTools port and Stash's port; byparr
# is only reached from stash over loopback, so it needs no entry).
# Stash runs on 9990 (port: in its config.yml) because the headless-shell image holds 127.0.0.1:9999
FIREWALL_INPUT_PORTS=9222,9990
